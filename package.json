{
  "name": "zycus-codearena",
  "private": true,
  "version": "0.1.0",
  "description": "Zycus CodeArena — Hands-On Coding Assessment platform (internal).",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22.22"
  },
  "scripts": {
    "dev": "vite",
    "dev:mock": "vite --mode mock --port 5174 --strictPort",
    "preview:mock": "vite build --mode mock --outDir dist-mock && vite preview --mode mock --outDir dist-mock --port 4174 --strictPort",
    "local:db": "node scripts/local-stack.ts",
    "dev:local": "vite --mode localstack --port 5175 --strictPort",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:web": "vitest run --project web",
    "test:db": "vitest run --project db",
    "seed:build": "node scripts/build-seed.ts",
    "seed:check": "node scripts/build-seed.ts --check",
    "check": "npm run lint && npm run format:check && npm run seed:check && npm run test && npm run build",
    "sql:bundle": "node scripts/bundle-sql.ts",
    "sql:copy": "node scripts/copy-sql.ts",
    "assistant:worker": "node --use-system-ca scripts/assistant-worker.ts",
    "local:worker": "node --use-system-ca scripts/local-worker.ts",
    "models:fetch": "node --use-system-ca scripts/fetch-models.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@mediapipe/tasks-vision": "1.0.1",
    "@supabase/supabase-js": "2.117.3",
    "clsx": "2.1.1",
    "fflate": "0.8.3",
    "idb-keyval": "6.3.0",
    "java-parser": "3.0.1",
    "lucide-react": "1.53.0",
    "monaco-editor": "0.57.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "react-resizable-panels": "4.14.3",
    "react-router": "8.4.0",
    "react-test-renderer": "19.3.0",
    "rehype-sanitize": "6.0.0",
    "remark-gfm": "4.0.1",
    "zod": "4.6.5",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/react-test-renderer": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "fake-indexeddb": "6.2.5",
    "globals": "17.13.0",
    "jsdom": "30.1.2",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  },
  "overrides": {
    "dompurify": "3.4.16",
    "lodash": "4.18.1",
    "lodash-es": "4.18.1"
  }
}
